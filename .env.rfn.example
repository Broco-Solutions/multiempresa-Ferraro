# RFN POS integration variables for Multi-Empresa (server-side only).
# Configure these through deployment secrets or local .env; never commit real values.
RFN_API_BASE_URL="https://gestion.rfn-argentina.com/"
RFN_API_KEY="replace-with-the-private-key-configured-in-rfn"
RFN_EXPECTED_COMPANY_ID="rfn-argentina"

# On RFN POS itself, the corresponding secret is CONSOLIDADO_API_KEY.
# Do not set RFN_API_KEY as NEXT_PUBLIC_*, and do not put secrets in the UI.
